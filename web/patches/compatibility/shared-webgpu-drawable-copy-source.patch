diff --git a/src/gpu/webgpu/WebGPUWindow.cpp b/src/gpu/webgpu/WebGPUWindow.cpp
--- a/src/gpu/webgpu/WebGPUWindow.cpp
+++ b/src/gpu/webgpu/WebGPUWindow.cpp
@@ -150,7 +150,8 @@ std::shared_ptr<WebGPUWindow> WebGPUWindow::MakeFromCanvas(emscripten::val canvas
